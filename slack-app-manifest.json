{
  "display_information": {
    "name": "Volta Signal",
    "description": "Monthly founders newsletter review and approval",
    "background_color": "#0b5fff"
  },
  "features": {
    "bot_user": {
      "display_name": "Volta Signal",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/volta",
        "url": "https://volta-signal-staging.volta-signal.workers.dev/slack/commands",
        "description": "Manually publish the monthly review card or check status",
        "usage_hint": "publish | card | status",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["commands", "chat:write", "chat:write.public", "channels:read", "groups:read"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://volta-signal-staging.volta-signal.workers.dev/slack/actions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
